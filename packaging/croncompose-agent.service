[Unit]
Description=CronCompose agent
Documentation=https://github.com/croncompose/croncompose
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=croncompose
Group=croncompose
EnvironmentFile=-/etc/croncompose/agent.env
ExecStart=/usr/local/bin/croncompose-agent run
Restart=always
RestartSec=5s
# NoNewPrivileges must stay off: the service user runs
# `sudo -n /usr/libexec/croncompose/agent-privctl elevate|demote`, which needs setuid.
ProtectSystem=full
# ProtectSystem=full makes /etc read-only for the agent and its sudo children, so
# agent-privctl could not write its root.conf drop-in. postinstall creates the dir.
ReadWritePaths=-/etc/systemd/system/croncompose-agent.service.d
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
