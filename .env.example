# CronCompose configuration. Copy to .env at the repo root and edit:
#
#   cp .env.example .env && chmod 600 .env
#
# ./install/install.sh normally writes this file for you; use this template for a manual
# install or to look up a key. .env is git-ignored and holds secrets, so keep it mode
# 600. After editing, restart: make pm2-restart (pm2) or ./croncompose-ctl.sh restart.
#
# Values below are shaped for a Cloudflare Tunnel deployment: cloudflared runs on this
# host and forwards one hostname to the control plane's HTTP port. Ports are picked to
# avoid the existing tunnel services (3000, 3001, 3100, 5151, 8080). For a plain LAN
# install, use http://<host>:8232 for PUBLIC_BASE_URL, bind HTTP_ADDR to :8232, and drop
# the agents hostname.

APP_ENV=prod
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Postgres DSN. Required. Keep Postgres on loopback; never expose 5432.
DATABASE_URL=postgres://croncompose:croncompose@localhost:5432/croncompose?sslmode=disable

# --- Listeners -------------------------------------------------------------
# HTTP_ADDR is the only HTTP surface: UI at /app, REST at /api. Behind a tunnel bind it
# to loopback so 8232 is reachable only by cloudflared on this host. Without a tunnel
# (direct/LAN), use :8232 instead.
HTTP_ADDR=127.0.0.1:8232
#
# GRPC_ADDR is the mTLS endpoint agents dial. It must stay on 0.0.0.0 and be reachable
# directly whenever agents run on other machines: the gateway requires and verifies a
# client certificate, so this traffic cannot pass through a Cloudflare HTTP tunnel.
# If every agent runs on this same box, bind it to 127.0.0.1:5152 and expose nothing.
GRPC_ADDR=:5152

# --- External address ------------------------------------------------------
# Single point of change. Derives PUBLIC_HTTP_URL (<base>/api/v1), PUBLIC_GRPC_ADDR,
# the OIDC redirect, and an extra TLS SAN. Set it to what browsers actually type: the
# tunnel hostname.
PUBLIC_BASE_URL=https://cron.workvar.com
#
# The address handed to agents at enrollment. Set it explicitly whenever gRPC lives on a
# different name than the UI. Left unset it derives from PUBLIC_BASE_URL's host, which
# would point agents at the tunnel hostname, and the tunnel does not serve gRPC.
# Delete this line if all agents are local.
PUBLIC_GRPC_ADDR=agents.workvar.com:5152

# --- Secrets ---------------------------------------------------------------
# Generate both with: openssl rand -hex 32
# SESSION_SECRET signs session cookies (16+ chars).
# SECRETS_MASTER_KEY (64 hex chars) wraps stored secrets. Back it up offline; losing it
# makes every stored secret unrecoverable. The built-in default is a dev-only key.
SESSION_SECRET=
SECRETS_MASTER_KEY=

# --- Bootstrap admin -------------------------------------------------------
# Upserted on every boot. Blank both out once real accounts exist, so a leaked .env
# cannot reset the admin password on the next restart.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Agent-facing TLS ------------------------------------------------------
# TLS_DIR holds the generated CA and server cert; persist it across upgrades. This PKI
# is independent of Cloudflare's edge certificate, which never touches the gRPC port.
# TLS_HOSTS must list every name an agent dials, or the handshake fails on the SAN.
# PUBLIC_BASE_URL's host is appended automatically. After changing this, delete
# $CC_RUNTIME_DIR/tls so the server cert regenerates.
TLS_DIR=./.run/tls
TLS_HOSTS=localhost,127.0.0.1,agents.workvar.com

# How long a server enrollment token stays valid.
ENROLL_TOKEN_TTL=30m

# --- Web UI (internal) -----------------------------------------------------
# The UI binds loopback and is reached only through the control plane's /app proxy.
# Never expose PORT or add a tunnel ingress rule for it; that would route around auth.
# Leave WEB_UPSTREAM empty for an API-only install.
# API_BASE is inlined at build time by next.config.ts, so set it before `npm run build`,
# not just at runtime. It stays loopback because it is a server-side, same-host call.
PORT=3231
WEB_UPSTREAM=http://127.0.0.1:3231
API_BASE=http://127.0.0.1:8232/api/v1

# --- OIDC SSO (optional) ---------------------------------------------------
# OIDC_REDIRECT_URL derives from PUBLIC_BASE_URL (<base>/api/v1/auth/oidc/callback),
# so register that URL with your IdP and leave it unset here.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DEFAULT_ROLE=viewer

# --- Local agent (optional) ------------------------------------------------
# Only for an agent running on this same machine, and written by the installer after
# enrollment. Loopback throughout: a local agent never leaves the host. The pm2 config
# starts the agent only once DATA_DIR/identity.json exists. Set CC_ENABLE_AGENT=1 too.
# CONTROL_PLANE_HTTP=http://127.0.0.1:8232/api/v1
# CONTROL_PLANE_ADDR=127.0.0.1:5152
# CONTROL_PLANE_SNI=localhost
# DATA_DIR=./.run/agent

# --- Installer / process manager metadata ----------------------------------
# Read by croncompose-ctl.sh and ecosystem.config.js to decide ports, where logs go,
# and which processes to start. CC_ADVERTISE_HOST is only used to build a default
# PUBLIC_BASE_URL, which is set explicitly above.
CC_RUNTIME_DIR=./.run
CC_ADVERTISE_HOST=cron.workvar.com
CC_API_PORT=8232
CC_GRPC_PORT=5152
CC_WEB_PORT=3231
CC_ENABLE_WEB=1
CC_ENABLE_AGENT=0
