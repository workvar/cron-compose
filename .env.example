# CronCompose configuration. Copy to .env at the repo root and edit:
#
#   cp .env.example .env && chmod 600 .env
#
# ./install/install.sh normally writes this file for you; use this template only for a
# manual install or to look up a key you want to add. .env is git-ignored and holds
# secrets, so keep it mode 600. After editing, restart: make pm2-restart (pm2) or
# ./croncompose-ctl.sh restart.

APP_ENV=prod
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Postgres DSN. Required.
DATABASE_URL=postgres://croncompose:croncompose@localhost:5432/croncompose?sslmode=disable

# --- Listeners -------------------------------------------------------------
# HTTP_ADDR is the single public entry point: it serves the UI at /app and REST at /api.
# GRPC_ADDR is the mTLS endpoint agents dial. Both must be reachable from outside.
HTTP_ADDR=:8080
GRPC_ADDR=:9090

# --- External address ------------------------------------------------------
# Single point of change. Derives PUBLIC_HTTP_URL (<base>/api/v1), PUBLIC_GRPC_ADDR
# (<host>:<GRPC_ADDR port>), the OIDC redirect, and an extra TLS SAN. Set it to whatever
# browsers and agents actually type, e.g. https://cron.example.com.
PUBLIC_BASE_URL=http://localhost:8080

# --- Secrets ---------------------------------------------------------------
# Generate both with: openssl rand -hex 32
# SESSION_SECRET signs session cookies (16+ chars).
# SECRETS_MASTER_KEY (64 hex chars) wraps stored secrets. Back it up offline; losing it
# makes every stored secret unrecoverable. The built-in default is a dev-only key.
SESSION_SECRET=
SECRETS_MASTER_KEY=

# --- Bootstrap admin -------------------------------------------------------
# Upserted on every boot. Blank both out once real accounts exist, so a leaked .env
# cannot reset the admin password on the next restart.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# --- Agent-facing TLS ------------------------------------------------------
# TLS_DIR holds the generated CA and server cert; persist it across upgrades.
# TLS_HOSTS must include the hostname agents dial, or their mTLS handshake fails.
# Delete TLS_DIR to regenerate the cert after changing the host.
TLS_DIR=./.run/tls
TLS_HOSTS=localhost,127.0.0.1

# How long a server enrollment token stays valid.
ENROLL_TOKEN_TTL=30m

# --- Web UI (internal) -----------------------------------------------------
# The control plane reverse-proxies /app to this address; the UI itself binds loopback.
# Leave WEB_UPSTREAM empty for an API-only install.
# API_BASE is inlined at build time by next.config.ts, so set it before `npm run build`,
# not just at runtime.
PORT=3000
WEB_UPSTREAM=http://127.0.0.1:3000
API_BASE=http://127.0.0.1:8080/api/v1

# --- OIDC SSO (optional) ---------------------------------------------------
# OIDC_REDIRECT_URL derives from PUBLIC_BASE_URL unless set explicitly.
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DEFAULT_ROLE=viewer

# --- Local agent (optional) ------------------------------------------------
# Only needed when running an agent on this same machine. Written by the installer
# after enrollment; the pm2 config starts the agent only once DATA_DIR/identity.json
# exists.
# CONTROL_PLANE_HTTP=http://127.0.0.1:8080/api/v1
# CONTROL_PLANE_ADDR=127.0.0.1:9090
# CONTROL_PLANE_SNI=localhost
# DATA_DIR=./.run/agent

# --- Installer / process manager metadata ----------------------------------
# Read by croncompose-ctl.sh and ecosystem.config.js to decide ports, where logs go,
# and which processes to start.
CC_RUNTIME_DIR=./.run
CC_ADVERTISE_HOST=localhost
CC_API_PORT=8080
CC_GRPC_PORT=9090
CC_WEB_PORT=3000
CC_ENABLE_WEB=1
CC_ENABLE_AGENT=0
